{
  "manifest_version": 3,
  "name": "NovelAI 自動生成",
  "version": "1.4.1",
  "description": "NovelAI の画像生成ボタンを自動でくり返し押します",
  "permissions": [
    "storage",
    "notifications"
  ],
  "icons": {
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://novelai.net/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "novelai-auto-generate@yuu10",
      "strict_min_version": "115.0"
    }
  }
}
